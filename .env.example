# Variable reference only: configure these in your shell or IntelliJ.
# The documented setup does not load this file.
DB_URL=jdbc:postgresql://localhost:9544/db_iam_service
DB_USERNAME=iteuser
DB_PASSWORD=replace-with-your-database-password
SERVER_PORT=9000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
IAM_ISSUER=http://localhost:9000
IAM_SIGNING_KEY_FILE=.local/iam-signing-key.json
IAM_OIDC_CLIENT_ID=iam-web-client
IAM_OIDC_CLIENT_SECRET=replace-with-a-long-random-secret
IAM_DCR_CLIENT_ID=iam-registration
IAM_DCR_CLIENT_SECRET=replace-with-another-long-random-secret
# Optional first-run administrator. Existing users are never reset/elevated.
IAM_ADMIN_USERNAME=admin
IAM_ADMIN_EMAIL=admin@istad.local
IAM_ADMIN_PASSWORD=
# Optional social providers: fill both fields to enable a registration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Override only with a callback URI approved in that provider's dashboard.
GOOGLE_REDIRECT_URI=http://localhost:9000/login/oauth2/code/google
GITHUB_REDIRECT_URI=http://localhost:9000/login/oauth2/code/github
FACEBOOK_REDIRECT_URI=http://localhost:9000/login/oauth2/code/facebook
TELEGRAM_REDIRECT_URI=http://localhost:9000/login/oauth2/code/telegram
# Optional Next.js portfolio client, enabled when its secret is set.
IAM_PORTFOLIO_CLIENT_SECRET=
IAM_PORTFOLIO_ORIGIN=http://localhost:3000

# For local captured email, use SPRING_PROFILES_ACTIVE=local and leave MAIL_* unset.
# Run: bash scripts/run-local.sh. Read email at http://localhost:8025.
# For real SMTP delivery, use the default profile and configure the following.
# Gmail requires an app password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# IAM_MAIL_FROM=your@gmail.com

# Resend SMTP delivery: select the resend profile instead of local.
# SPRING_PROFILES_ACTIVE=resend
# RESEND_API_KEY=your-resend-api-key
# IAM_MAIL_FROM='ISTAD Identity <no-reply@your-verified-domain.com>'
# Without a verified domain, onboarding@resend.dev can send only to your Resend account email.

# Gmail SMTP without a custom domain. Prefer: python3 scripts/configure-gmail.py
# SPRING_PROFILES_ACTIVE=gmail
# GMAIL_USERNAME=your@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-google-app-password

# Optional absolute path to a local GeoLite2/GeoIP2 City .mmdb database.
IAM_GEOIP_DATABASE=
